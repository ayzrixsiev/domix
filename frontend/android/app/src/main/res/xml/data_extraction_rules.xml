<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. shared preferences hold flutter_secure_storage's ciphertext and wrapped key, and the
     Keystore key that opens them never leaves the phone: restored onto another install they cannot
     be decrypted, so they are never carried over. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
