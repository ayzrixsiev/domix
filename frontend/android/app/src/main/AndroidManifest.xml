<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- unlike the debug/profile manifests, this one is used for release builds too - without this,
         every network call (auth, map tiles, geocoding) would silently fail once shipped -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- «Рядом со мной» on the map, and nothing else - the fix moves the camera and is never sent
         anywhere. COARSE is declared alongside FINE because from Android 12 the system dialog lets
         the user grant only the approximate one; a city block is plenty for "what is near me", so
         asking for FINE alone would turn that choice into a refusal. Foreground only: there is no
         ACCESS_BACKGROUND_LOCATION here, and adding one would need its own Play declaration. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- the name under the launcher icon. it was "frontend" - the flutter project's folder name -
         which is what every user would have seen on their home screen. -->
    <application
        android:label="Domix"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <!-- **Android 11 made other apps invisible by default, and url_launcher depends on seeing
             them.** From API 30 an app cannot enumerate or resolve intents against packages it has
             not declared an interest in here. `canLaunchUrl` works by resolving the intent, so
             without this block it returns **false for every https URL** - even with Telegram
             installed and a browser on the phone - and the login flow reports "Telegram is not
             installed" while Telegram sits on the home screen.

             It fails on a real phone and nowhere else, and it fails *silently* in the sense that
             nothing in logcat names package visibility. The evidence was on the server: the app
             sent POST /api/auth/init and then never once polled /api/auth/status, because the throw
             happened between the two. targetSdk is 36, so this applies to every build we ship. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- the shop card's call button (`tel:`) is the same trap one screen over - it would
             resolve to nothing on the same phones. -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <!-- «Маршрут» on the shop card. `geo:` is the platform's own maps scheme rather than any one
             app's, so every maps app installed on the phone answers it and Android shows a chooser -
             which is the whole point: the previous version opened a yandex.uz url, so a phone with
             Google Maps and no Yandex got a web page instead of the app it already had. The url is
             still the fallback, and it is covered by the VIEW+https entry above. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="geo"/>
        </intent>
        <!-- Required to query activities that can process text, see:
             https://developer.android.com/training/package-visibility and
             https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

             In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
